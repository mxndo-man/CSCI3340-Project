DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=postgres://foo:foo@localhost:5432/foo
EXTRACTOR_MODE=stub
EXTRACTOR_URL=http://localhost:8001
REDIS_URL=redis://localhost:6379/0
# 1 = show every page on sample data at /preview/, until the real models exist.
UI_PREVIEW=1

POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=change-me

# Email: console by default; Docker switches it to Mailpit (UI at http://localhost:8025)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=localhost
